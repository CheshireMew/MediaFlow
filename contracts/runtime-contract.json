{
  "task_contract_version": 4,
  "desktop_bridge_contract_version": 4,
  "task_statuses": [
    "pending",
    "running",
    "processing_result",
    "completed",
    "failed",
    "cancelled",
    "paused"
  ],
  "task_sources": [
    "backend"
  ],
  "task_persistence_scopes": [
    "runtime",
    "history"
  ],
  "task_queue_states": [
    "queued",
    "running",
    "paused",
    "cancelled",
    "completed",
    "failed",
    "idle"
  ],
  "task_message_codes": [
    "queued",
    "queued_long_segment",
    "starting",
    "running",
    "completed",
    "failed",
    "paused",
    "cancelled",
    "deleted",
    "deleted_count",
    "pause_requested",
    "cancellation_requested",
    "paused_in_queue",
    "cancelled_in_queue",
    "interrupted_by_restart",
    "resumed",
    "already_running",
    "already_active",
    "restarted",
    "execution_spec_missing",
    "pipeline_starting",
    "pipeline_step_running",
    "pipeline_step_failed",
    "pipeline_completed",
    "download_progress",
    "download_stage_completed",
    "download_subtitle_failed",
    "download_completed",
    "transcription_starting",
    "transcription_progress",
    "transcription_completed",
    "transcription_segment_processing",
    "transcription_segment_completed",
    "asr_cli_warmup_waiting",
    "asr_audio_splitting",
    "asr_chunks_progress",
    "asr_model_preparing",
    "asr_model_downloading",
    "asr_model_source_fallback",
    "asr_model_initializing",
    "asr_model_loaded",
    "asr_cuda_cpu_fallback",
    "asr_finalizing",
    "translation_starting",
    "translation_batch_progress",
    "translation_completed",
    "synthesis_preparing",
    "synthesis_starting",
    "synthesis_encoding",
    "synthesis_completed",
    "clip_export_preparing",
    "clip_exporting",
    "clip_export_completed"
  ],
  "task_status_projection": {
    "pending": {
      "persistence_scope": "runtime",
      "lifecycle": "resumable",
      "queue_state": "queued",
      "is_active": true,
      "is_running": false
    },
    "running": {
      "persistence_scope": "runtime",
      "lifecycle": "resumable",
      "queue_state": "running",
      "is_active": true,
      "is_running": true
    },
    "processing_result": {
      "persistence_scope": "runtime",
      "lifecycle": "resumable",
      "queue_state": "running",
      "is_active": true,
      "is_running": true
    },
    "completed": {
      "persistence_scope": "history",
      "lifecycle": "history-only",
      "queue_state": "completed",
      "is_active": false,
      "is_running": false
    },
    "failed": {
      "persistence_scope": "history",
      "lifecycle": "history-only",
      "queue_state": "failed",
      "is_active": false,
      "is_running": false
    },
    "cancelled": {
      "persistence_scope": "history",
      "lifecycle": "history-only",
      "queue_state": "cancelled",
      "is_active": false,
      "is_running": false
    },
    "paused": {
      "persistence_scope": "runtime",
      "lifecycle": "resumable",
      "queue_state": "paused",
      "is_active": true,
      "is_running": false
    }
  },
  "asr_execution_preferences": {
    "key": "asr_execution_preferences",
    "schema_version": 1,
    "defaults": {
      "engine": "builtin",
      "model": "base",
      "device": "cpu"
    }
  },
  "task_lifecycle": {
    "runtime_only": "runtime-only",
    "history_only": "history-only",
    "resumable": "resumable",
    "ephemeral_ui": "ephemeral-ui"
  }
}
