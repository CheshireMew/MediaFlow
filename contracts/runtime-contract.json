{
  "task_contract_version": 2,
  "desktop_bridge_contract_version": 1,
  "task_owner_mode": "backend",
  "task_statuses": [
    "pending",
    "running",
    "processing_result",
    "completed",
    "failed",
    "cancelled",
    "paused"
  ],
  "task_sources": [
    "backend"
  ],
  "task_persistence_scopes": [
    "runtime",
    "history"
  ],
  "task_queue_states": [
    "queued",
    "running",
    "paused",
    "cancelled",
    "completed",
    "failed",
    "idle"
  ],
  "task_status_projection": {
    "pending": {
      "persistence_scope": "runtime",
      "lifecycle": "resumable",
      "queue_state": "queued",
      "is_active": true,
      "is_running": false
    },
    "running": {
      "persistence_scope": "runtime",
      "lifecycle": "resumable",
      "queue_state": "running",
      "is_active": true,
      "is_running": true
    },
    "processing_result": {
      "persistence_scope": "runtime",
      "lifecycle": "resumable",
      "queue_state": "running",
      "is_active": true,
      "is_running": true
    },
    "completed": {
      "persistence_scope": "history",
      "lifecycle": "history-only",
      "queue_state": "completed",
      "is_active": false,
      "is_running": false
    },
    "failed": {
      "persistence_scope": "history",
      "lifecycle": "history-only",
      "queue_state": "failed",
      "is_active": false,
      "is_running": false
    },
    "cancelled": {
      "persistence_scope": "history",
      "lifecycle": "history-only",
      "queue_state": "cancelled",
      "is_active": false,
      "is_running": false
    },
    "paused": {
      "persistence_scope": "runtime",
      "lifecycle": "resumable",
      "queue_state": "paused",
      "is_active": true,
      "is_running": false
    }
  },
  "features": {
    "preprocessing": true
  },
  "task_lifecycle": {
    "runtime_only": "runtime-only",
    "history_only": "history-only",
    "resumable": "resumable",
    "ephemeral_ui": "ephemeral-ui"
  }
}
